# Backend Environment Configuration
# Set these environment variables in your Render backend settings

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=your-database-url-here
SUPABASE_URL=your-supabase-url-here
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration - Allow Vercel frontend and local development
# For production with Vercel frontend:
ALLOWED_ORIGINS=https://rail-fit.vercel.app,https://railfit-backend.onrender.com

# For development (add these if testing locally):
# ALLOWED_ORIGINS=https://rail-fit.vercel.app,https://railfit-backend.onrender.com,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Frontend URL (for redirects, cookies, etc.)
FRONTEND_URL=https://rail-fit.vercel.app

# Debug Mode (set to false in production)
DEBUG=false

# File Upload Settings
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads/

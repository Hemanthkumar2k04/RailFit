SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5seHJwbmpjY291b2dyZmJiZ21rIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTgzNzM2NjQsImV4cCI6MjA3Mzk0OTY2NH0.begglCbsqiTX7Sop_09BpTRHw31NGm9nThoTkk4aEJE

# Database connection string for SQLAlchemy/asyncpg
# Format: postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres
# Note: @ symbol in password is URL-encoded as %40
DATABASE_URL=postgresql://postgres:DT1qzY9irFNIYkWx@db.nlxrpnjccouogrfbbgmk.supabase.co:5432/postgres

# JWT Secret Key for authentication (generate a strong random key)
JWT_SECRET_KEY=89a55cdf9f854e723e17cc9264e3836efb932460b146719610bc80c6512f8b4c

# JWT Algorithm
JWT_ALGORITHM=HS256

# JWT Token expiration time (in minutes) 
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# JWT_ACCESS_TOKEN_EXPIRE_HOURS=24  # Old variable, replaced with minutes

# Application Settings
APP_NAME=RailFit Asset Management
# APP_VERSION=1.0.0  # Using 'version' field in config
DEBUG=true

# CORS Settings (configured in code for now)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload Settings
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# How to set up Supabase:
# 1. Go to https://supabase.com and create a free account
# 2. Create a new project
# 3. Go to Settings > API to get your URL and keys
# 4. Go to Settings > Database to get your database password
# 5. Replace the placeholder values above with your actual values
# 6. Copy this file to .env (without .example) and update the values